# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
SWAGGER_PATH=api/docs
APP_NAME="Sun* Conduit API"

# Internationalization (i18n)
FALLBACK_LANGUAGE=en

# JWT Configuration
JWT_SECRET=super-secret-jwt-key-for-sun-tutorial-2026
JWT_EXPIRES_IN=7d

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=sun_conduit_dev
DB_TEST_NAME=sun_conduit_test

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Mail / SMTP Configuration (Mailpit local default: port 1025, Web UI: 8025)
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Sun* Conduit <no-reply@sun-conduit.local>"

# Scheduler Configuration
SCHEDULER_ENABLED=true
